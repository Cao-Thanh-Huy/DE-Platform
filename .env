# ============================================================
# DE Platform - Environment Variables
# ============================================================

# --- PostgreSQL (shared: Nessie + Dagster) ---
POSTGRES_USER=deplatform
POSTGRES_PASSWORD=deplatform123
POSTGRES_DB=deplatform

# --- MinIO ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio123456
MINIO_ENDPOINT=minio:9000
MINIO_WAREHOUSE_BUCKET=warehouse
MINIO_RAW_BUCKET=raw-data

# --- Nessie ---
NESSIE_PORT=19120

# --- Trino ---
TRINO_PORT=8080
TRINO_USER=admin

# --- Vault ---
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token
VAULT_ADDR=http://vault:8200

# --- Dagster ---
DAGSTER_POSTGRES_USER=deplatform
DAGSTER_POSTGRES_PASSWORD=deplatform123
DAGSTER_POSTGRES_HOST=postgres
DAGSTER_POSTGRES_DB=deplatform
DAGSTER_WEBSERVER_PORT=3001

# --- FastAPI Backend ---
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=3000
